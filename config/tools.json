{
  "$comment": "Tool registry. Each entry maps one MCP tool to one upstream x402 route. The baseUrls below follow the suite's local-port convention (4000 + the service's suite id) — point them at your own deployments with X402_UPSTREAM_<UPSTREAM>, or at x402-agent-sandbox (config/tools.sandbox.json) to rehearse the whole toolbox for fractions of a cent. `rail` is optional and overrides the server-wide default (auto | evm | solana).",
  "defaults": {
    "rail": "auto",
    "timeoutMs": 20000
  },
  "tools": [
    {
      "name": "url_to_markdown",
      "description": "Convert a public webpage URL to clean Markdown for RAG, grounding, research, summarization and LLM context.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "POST",
      "path": "/web/markdown",
      "price": "$0.001",
      "input": {
        "url": {
          "type": "string",
          "required": true,
          "description": "Public http(s) webpage URL."
        },
        "max_chars": {
          "type": "number",
          "description": "Maximum Markdown characters to return, up to 150000."
        },
        "timeout_seconds": {
          "type": "number",
          "description": "Fetch timeout in seconds, 5-60."
        }
      },
      "rail": "evm"
    },
    {
      "name": "monitor_webpage",
      "description": "Detect meaningful webpage changes for prices, inventory, availability, documentation, policies and competitor monitoring. For recurring checks, pass the prior response current_hash back as previous_hash.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "POST",
      "path": "/change",
      "price": "$0.001",
      "input": {
        "url": {
          "type": "string",
          "required": true,
          "description": "Public webpage URL to inspect."
        },
        "previous_hash": {
          "type": "string",
          "description": "Prior deterministic hash from the preceding successful check."
        },
        "previous_text": {
          "type": "string",
          "description": "Optional prior text for diff generation."
        },
        "include_current_text": {
          "type": "boolean",
          "description": "Include current normalized text in the response."
        },
        "timeout_seconds": {
          "type": "number",
          "description": "Fetch timeout in seconds, 5-60."
        }
      },
      "rail": "evm"
    },
    {
      "name": "extract_web_metadata",
      "description": "Extract title, description, canonical URL, robots directives, headings, OpenGraph, Twitter cards and JSON-LD for one public URL.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "POST",
      "path": "/metadata-single",
      "price": "$0.001",
      "input": {
        "url": {
          "type": "string",
          "required": true,
          "description": "Public http(s) webpage URL."
        },
        "timeout_seconds": {
          "type": "number",
          "description": "Fetch timeout in seconds, 5-60."
        }
      },
      "rail": "evm"
    },
    {
      "name": "wallet_balance",
      "description": "Return native ETH and USDC balances for one wallet on Base or Ethereum.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "GET",
      "path": "/wallet-balance/cdp",
      "price": "$0.001",
      "query": [
        "address",
        "chain"
      ],
      "input": {
        "address": {
          "type": "string",
          "required": true,
          "description": "20-byte EVM wallet address."
        },
        "chain": {
          "type": "string",
          "description": "CAIP-2 chain id; eip155:8453 for Base or eip155:1 for Ethereum."
        }
      },
      "rail": "evm"
    },
    {
      "name": "search_flights",
      "description": "Search flights between two airports on a date. Returns priced offers with airline, times, stops and fare basis.",
      "upstream": "x402-flight-search",
      "baseUrl": "http://localhost:4007",
      "method": "GET",
      "path": "/search",
      "price": "$0.005",
      "query": [
        "origin",
        "destination",
        "departureDate",
        "returnDate",
        "adults",
        "maxPrice"
      ],
      "input": {
        "origin": {
          "type": "string",
          "required": true,
          "description": "IATA origin airport code, e.g. SFO"
        },
        "destination": {
          "type": "string",
          "required": true,
          "description": "IATA destination airport code, e.g. JFK"
        },
        "departureDate": {
          "type": "string",
          "required": true,
          "description": "YYYY-MM-DD"
        },
        "returnDate": {
          "type": "string",
          "description": "YYYY-MM-DD for a round trip"
        },
        "adults": {
          "type": "number",
          "description": "Passenger count, default 1"
        },
        "maxPrice": {
          "type": "number",
          "description": "Cap on total fare"
        }
      }
    },
    {
      "name": "price_flight",
      "description": "Confirm the live price and availability of a specific flight offer before booking.",
      "upstream": "x402-flight-search",
      "baseUrl": "http://localhost:4007",
      "method": "GET",
      "path": "/price/{offerId}",
      "price": "$0.003",
      "input": {
        "offerId": {
          "type": "string",
          "required": true,
          "description": "offerId from search_flights"
        }
      }
    },
    {
      "name": "find_tables",
      "description": "List open restaurant reservation slots for a date and party size.",
      "upstream": "x402-tablebook",
      "baseUrl": "http://localhost:4001",
      "method": "GET",
      "path": "/availability",
      "price": "$0.001",
      "query": [
        "date",
        "party",
        "days"
      ],
      "input": {
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD"
        },
        "party": {
          "type": "number",
          "description": "Party size, 1-8"
        },
        "days": {
          "type": "number",
          "description": "Days to scan when no date is given"
        }
      }
    },
    {
      "name": "book_table",
      "description": "Book a restaurant table. Returns the confirmed reservation with a cancel token, refund terms and a calendar invite. The hold is refundable.",
      "upstream": "x402-tablebook",
      "baseUrl": "http://localhost:4001",
      "method": "POST",
      "path": "/book",
      "price": "$0.01",
      "input": {
        "date": {
          "type": "string",
          "required": true,
          "description": "YYYY-MM-DD"
        },
        "time": {
          "type": "string",
          "required": true,
          "description": "HH:MM, 24-hour"
        },
        "party": {
          "type": "number",
          "required": true,
          "description": "Party size, 1-8"
        },
        "name": {
          "type": "string",
          "required": true,
          "description": "Name on the reservation"
        },
        "notes": {
          "type": "string",
          "description": "Requests for the restaurant"
        }
      }
    },
    {
      "name": "search_hotels",
      "description": "Search hotel rooms and offers for a city and date range.",
      "upstream": "x402-hotel-search",
      "baseUrl": "http://localhost:4008",
      "method": "GET",
      "path": "/search",
      "price": "$0.005",
      "query": [
        "cityCode",
        "checkIn",
        "checkOut",
        "adults"
      ],
      "input": {
        "cityCode": {
          "type": "string",
          "required": true,
          "description": "IATA city code, e.g. NYC"
        },
        "checkIn": {
          "type": "string",
          "required": true,
          "description": "YYYY-MM-DD"
        },
        "checkOut": {
          "type": "string",
          "required": true,
          "description": "YYYY-MM-DD"
        },
        "adults": {
          "type": "number",
          "description": "Guest count, default 2"
        }
      }
    },
    {
      "name": "check_weather",
      "description": "Forecast for a location, with the plan-relevant summary an agent needs to decide whether an outdoor booking is a good idea.",
      "upstream": "x402-weather-guard",
      "baseUrl": "http://localhost:4019",
      "method": "GET",
      "path": "/forecast",
      "price": "$0.001",
      "query": [
        "lat",
        "lon",
        "date"
      ],
      "input": {
        "lat": {
          "type": "number",
          "required": true,
          "description": "Latitude"
        },
        "lon": {
          "type": "number",
          "required": true,
          "description": "Longitude"
        },
        "date": {
          "type": "string",
          "description": "YYYY-MM-DD, defaults to today"
        }
      }
    },
    {
      "name": "browse_catalog",
      "description": "List a storefront's items with prices and buy routes. Free at the merchant.",
      "upstream": "x402-storefront",
      "baseUrl": "http://localhost:4006",
      "method": "GET",
      "path": "/catalog",
      "price": "free",
      "input": {}
    },
    {
      "name": "buy_item",
      "description": "Buy an item from a storefront. Digital goods return a signed download URL and license; physical goods return a signed order confirmation and fulfillment record.",
      "upstream": "x402-storefront",
      "baseUrl": "http://localhost:4006",
      "method": "GET",
      "path": "/buy/{sku}",
      "price": "per item",
      "query": [
        "name",
        "address",
        "country"
      ],
      "input": {
        "sku": {
          "type": "string",
          "required": true,
          "description": "Item sku from browse_catalog"
        },
        "name": {
          "type": "string",
          "description": "Shipping name (physical items)"
        },
        "address": {
          "type": "string",
          "description": "Shipping address (physical items)"
        },
        "country": {
          "type": "string",
          "description": "ISO country code (physical items)"
        }
      }
    },
    {
      "name": "search_places",
      "description": "Find places — restaurants, shops, landmarks — near a point or in a named area.",
      "upstream": "x402-places",
      "baseUrl": "http://localhost:4012",
      "method": "GET",
      "path": "/search",
      "price": "$0.002",
      "query": [
        "q",
        "lat",
        "lon",
        "radius",
        "kind"
      ],
      "input": {
        "q": {
          "type": "string",
          "description": "Free-text query"
        },
        "lat": {
          "type": "number",
          "description": "Latitude"
        },
        "lon": {
          "type": "number",
          "description": "Longitude"
        },
        "radius": {
          "type": "number",
          "description": "Metres"
        },
        "kind": {
          "type": "string",
          "description": "Place category filter"
        }
      }
    },
    {
      "name": "search_news",
      "description": "Query the global news wire for coverage of a topic in a time window.",
      "upstream": "x402-news-wire",
      "baseUrl": "http://localhost:4017",
      "method": "GET",
      "path": "/query",
      "price": "$0.003",
      "query": [
        "q",
        "since",
        "limit"
      ],
      "input": {
        "q": {
          "type": "string",
          "required": true,
          "description": "Search query"
        },
        "since": {
          "type": "string",
          "description": "ISO timestamp or relative window, e.g. 24h"
        },
        "limit": {
          "type": "number",
          "description": "Max articles"
        }
      }
    },
    {
      "name": "check_domain",
      "description": "Check whether a domain is registered, and if so who holds it and when it expires.",
      "upstream": "x402-domains",
      "baseUrl": "http://localhost:4026",
      "method": "GET",
      "path": "/check/{domain}",
      "price": "$0.001",
      "input": {
        "domain": {
          "type": "string",
          "required": true,
          "description": "Domain name, e.g. example.com"
        }
      }
    },
    {
      "name": "track_confirmation",
      "description": "Normalize any merchant confirmation into a portable record plus an ICS calendar invite. Feed it the artifact any booking tool returned.",
      "upstream": "x402-confirmations",
      "baseUrl": "http://localhost:4037",
      "method": "POST",
      "path": "/track",
      "price": "$0.005",
      "input": {
        "confirmation": {
          "type": "object",
          "description": "Structured confirmation JSON from a merchant"
        },
        "rawText": {
          "type": "string",
          "description": "Freeform confirmation text, e.g. a pasted email"
        },
        "type": {
          "type": "string",
          "description": "restaurant | hotel | order | flight | appointment | generic"
        }
      }
    },
    {
      "name": "transaction_status",
      "description": "Check whether an EVM transaction is pending, confirmed or reverted, including confirmations and gas metadata.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "GET",
      "path": "/transaction-status",
      "price": "$0.001",
      "query": [
        "tx_hash",
        "network"
      ],
      "input": {
        "tx_hash": {
          "type": "string",
          "required": true,
          "description": "32-byte EVM transaction hash."
        },
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        }
      },
      "rail": "evm"
    },
    {
      "name": "gas_state",
      "description": "Return current gas price, latest block base fee and gas utilization on Base or Ethereum.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "GET",
      "path": "/gas-state",
      "price": "$0.001",
      "query": [
        "network"
      ],
      "input": {
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        }
      },
      "rail": "evm"
    },
    {
      "name": "erc20_allowance",
      "description": "Check an ERC-20 allowance from owner to spender before swaps, payments or autonomous contract execution.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "GET",
      "path": "/erc20-allowance",
      "price": "$0.001",
      "query": [
        "owner",
        "spender",
        "contract",
        "network"
      ],
      "input": {
        "owner": {
          "type": "string",
          "required": true,
          "description": "Owner EVM wallet address."
        },
        "spender": {
          "type": "string",
          "required": true,
          "description": "Spender/contract EVM address."
        },
        "contract": {
          "type": "string",
          "required": true,
          "description": "ERC-20 token contract address."
        },
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        }
      },
      "rail": "evm"
    },
    {
      "name": "wallet_activity",
      "description": "Return recent USDC or ERC-20 transfers for a wallet plus next_cursor for recurring payment and treasury monitoring.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "GET",
      "path": "/wallet-activity",
      "price": "$0.001",
      "query": [
        "address",
        "contract",
        "network",
        "cursor",
        "lookback_blocks"
      ],
      "input": {
        "address": {
          "type": "string",
          "required": true,
          "description": "EVM wallet address."
        },
        "contract": {
          "type": "string",
          "description": "ERC-20 contract; defaults to USDC."
        },
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        },
        "cursor": {
          "type": "number",
          "description": "Previous next_cursor block number."
        },
        "lookback_blocks": {
          "type": "number",
          "description": "Initial scan lookback, up to 5000 blocks."
        }
      },
      "rail": "evm"
    },
    {
      "name": "monitor_wallet",
      "description": "Recurring wallet monitor for balance changes and new USDC/ERC-20 transfers. Pass next_cursor and current_state_hash from the prior result into the next call.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "POST",
      "path": "/agent/wallet-monitor",
      "price": "$0.005",
      "input": {
        "address": {
          "type": "string",
          "required": true,
          "description": "EVM wallet address."
        },
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        },
        "activity_contract": {
          "type": "string",
          "description": "ERC-20 activity contract; defaults to USDC."
        },
        "cursor": {
          "type": "number",
          "description": "Previous next_cursor block number."
        },
        "lookback_blocks": {
          "type": "number",
          "description": "Initial scan lookback, up to 5000 blocks."
        },
        "previous_state_hash": {
          "type": "string",
          "description": "Prior current_state_hash for change detection."
        }
      },
      "rail": "evm"
    },
    {
      "name": "treasury_snapshot",
      "description": "One-call treasury snapshot: wallet balances, gas/base fee and recent USDC/ERC-20 activity with cursor/state for recurring polling.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "POST",
      "path": "/agent/treasury-snapshot",
      "price": "$0.01",
      "input": {
        "address": {
          "type": "string",
          "required": true,
          "description": "EVM wallet address."
        },
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        },
        "activity_contract": {
          "type": "string",
          "description": "ERC-20 activity contract; defaults to USDC."
        },
        "activity_cursor": {
          "type": "number",
          "description": "Previous activity cursor block number."
        },
        "lookback_blocks": {
          "type": "number",
          "description": "Initial scan lookback, up to 5000 blocks."
        },
        "previous_state_hash": {
          "type": "string",
          "description": "Prior current_state_hash for change detection."
        }
      },
      "rail": "evm"
    },
    {
      "name": "pretrade_context",
      "description": "Data-only pre-trade bundle: wallet state, ERC-20 allowance, gas/base fee, realtime price, 24h stats and best bid/ask spread. Never submits a trade.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "POST",
      "path": "/agent/pretrade",
      "price": "$0.01",
      "input": {
        "address": {
          "type": "string",
          "required": true,
          "description": "EVM wallet address."
        },
        "spender": {
          "type": "string",
          "required": true,
          "description": "Spender/contract EVM address."
        },
        "token_contract": {
          "type": "string",
          "required": true,
          "description": "ERC-20 token contract address."
        },
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        },
        "product_id": {
          "type": "string",
          "required": true,
          "description": "Coinbase Exchange market, e.g. BTC-USD."
        }
      },
      "rail": "evm"
    },
    {
      "name": "watch_transaction",
      "description": "Poll an EVM transaction until confirmed or reverted. Pass the prior current_state_hash back on later checks.",
      "upstream": "industrial-platform",
      "baseUrl": "https://x402-gateway-production-1f21.up.railway.app",
      "method": "POST",
      "path": "/agent/transaction-watch",
      "price": "$0.003",
      "input": {
        "tx_hash": {
          "type": "string",
          "required": true,
          "description": "32-byte EVM transaction hash."
        },
        "network": {
          "type": "string",
          "description": "base or ethereum; defaults to base."
        },
        "previous_state_hash": {
          "type": "string",
          "description": "Prior current_state_hash for change detection."
        }
      },
      "rail": "evm"
    }
  ]
}
