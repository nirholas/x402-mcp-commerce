# ════════════════════════════════════════════════════════════════════════════
#  AGENT SIDE — the wallet this MCP server pays upstream merchants with
# ════════════════════════════════════════════════════════════════════════════

# EVM wallet (Base / Base Sepolia). Signs the EIP-3009 USDC authorization.
# Use a throwaway key funded with a small amount — testnet USDC faucet:
# https://faucet.circle.com
PRIVATE_KEY=

# Solana wallet. Signs the SPL transferChecked. Base58 secret key, or a JSON
# byte array like the one `solana-keygen` writes. Optional — leave it unset and
# the agent simply never takes the Solana rail.
SOLANA_PRIVATE_KEY=

# ── Rail selection ──────────────────────────────────────────────────────────
# Which rail to pay on. auto = whichever rail this agent holds a key for.
#   X402_RAIL=auto | evm | solana
X402_RAIL=auto
# Per-tool override, uppercase tool name. Both of these are examples:
#   X402_RAIL_BOOK_TABLE=evm
#   X402_RAIL_CHECK_WEATHER=solana
# A model can also pass `rail` as an argument on an individual tool call.

# Solana RPC used to build the SPL transfer. The public endpoint is heavily
# rate limited — use a dedicated one (Helius / Triton / QuickNode) for real use.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# ── Spending caps (the x402-agent-wallet pattern) ───────────────────────────
# Checked BEFORE any payment is signed, against the real price in the upstream's
# 402 — so a runaway loop stops at the ledger, not at the chain.
MAX_PER_CALL_USD=0.05
MAX_SESSION_USD=1
MAX_CALLS=200
# Comma-separated allowlist. Empty means every registered tool is callable.
ALLOWED_TOOLS=

# ── Tool registry ───────────────────────────────────────────────────────────
# Path to the tool → upstream map. Defaults to ./config/tools.json
X402_TOOLS_CONFIG=
# Override one upstream's base URL without editing the file. Uppercase the
# upstream name and replace non-alphanumerics with underscores:
#   X402_UPSTREAM_X402_TABLEBOOK=https://tablebook.example.com
# Point them all at x402-agent-sandbox to rehearse the whole toolbox cheaply:
#   X402_UPSTREAM_X402_TABLEBOOK=http://localhost:4039
X402_TIMEOUT_MS=20000

# ════════════════════════════════════════════════════════════════════════════
#  MERCHANT SIDE — the inspector's one paid route, GET /attest
# ════════════════════════════════════════════════════════════════════════════
# These are the suite's public receive addresses — change them to get paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# EVM network: base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# Solana network: mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta

# EVM facilitator. The x402.org default only settles base-sepolia — switch to a
# mainnet facilitator (e.g. https://facilitator.payai.network) with NETWORK=base.
FACILITATOR_URL=https://x402.org/facilitator
# Solana facilitator. PayAI's public lane needs no API key and sponsors the SOL fee.
SOLANA_FACILITATOR_URL=https://facilitator.payai.network
# Facilitator sponsor account that pays the SOL network fee. Public, not a secret.
SOLANA_FEE_PAYER=2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4

# HMAC-SHA256 key behind the attestation signature.
SIGNING_SECRET=
# How long an attestation stays valid, in seconds.
ATTESTATION_TTL_SECONDS=300

# Inspector port.
PORT=4039
