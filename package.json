{
  "name": "x402-mcp-commerce",
  "version": "0.1.0",
  "description": "MCP server that gives Claude/GPT agents commerce tools — each tool call pays an upstream x402 endpoint and returns its artifact",
  "author": "nirholas <nichxbt@gmail.com>",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/x402-mcp-commerce"
  },
  "homepage": "https://nirholas.github.io/x402-mcp-commerce/",
  "keywords": [
    "x402",
    "micropayments",
    "usdc",
    "solana",
    "base",
    "ai-agents",
    "agentic-commerce",
    "http-402",
    "mcp",
    "model-context-protocol",
    "claude",
    "tool-use"
  ],
  "main": "dist/mcp.js",
  "bin": {
    "x402-mcp-commerce": "dist/mcp.js"
  },
  "files": [
    "dist",
    "config",
    "skill.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "mcp": "tsx src/mcp.ts",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/mcp.js",
    "inspector": "node dist/server.js",
    "client": "tsx examples/agent-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "@three-ws/x402-payment-modal": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "viem": "^2.21.0",
    "x402": "^1.2.0",
    "x402-fetch": "^1.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
